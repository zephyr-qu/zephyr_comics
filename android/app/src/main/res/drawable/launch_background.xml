<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window: the identity's paper with the seal centred. Flutter swaps
     this out as soon as it has drawn its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/window_background" />
    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_seal" />
</layer-list>
