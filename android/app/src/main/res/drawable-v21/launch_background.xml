<?xml version="1.0" encoding="utf-8"?>
<!-- API 21+ variant of the launch window. Kept identical to the base one: the
     template used `?android:colorBackground` here, which is white in the light
     theme and near-black in the dark one — neither is the app's paper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/window_background" />
    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_seal" />
</layer-list>
